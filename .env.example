NODE_ENV=development
PORT=3003
WHATSAPP_DEFAULT_SESSION=default
WHATSAPP_DEFAULT_APPLICATION_ID=default
WHATSAPP_AUTH_DIR=auth
WHATSAPP_SESSION_AUTH_ROOT=auth-sessions
WHATSAPP_SESSION_LOCK_ROOT=.session-locks
API_KEY_STORE=config/api-keys.json
MONGODB_URI=mongodb://localhost:27017/api_whatsapp?authMechanism=DEFAULT
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
MESSAGE_RATE_LIMIT_MAX=30
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000
RECONNECT_MAX_ATTEMPTS=0
CORS_ORIGIN=http://localhost:3000
WHATSAPP_AUTO_CONNECT=false
WHATSAPP_MONITOR_MODE=all
WHATSAPP_MONITORED_GROUPS=
WHATSAPP_DEBUG_INBOUND=false
WHATSAPP_INTERACTIVE_ENABLED=false
WEBHOOK_ENCRYPTION_KEY=<generate-a-32-byte-base64-secret>
WEBHOOK_ALLOW_LOCAL_TEST=false
WEBHOOK_LOCAL_TEST_HOST=127.0.0.1
WEBHOOK_LOCAL_TEST_PORT=3000
WEBHOOK_LOCAL_TEST_PATH=/webhooks/whatsapp
